<?xml version="1.0" encoding="utf-8"?>
<!--
  KAPALI SİSTEM: Bu uygulama INTERNET iznine sahip değildir.
  Fotoğraf okuma kütüphanesinin (ML Kit) eklediği ağ izinleri de aşağıda zorla kaldırılır.
  Veriler yalnızca telefonda tutulur ve Google yedeklemesine dahil edilmez (allowBackup=false).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ağ erişimi kesinlikle yok -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Bildirim göstermek (saatlik liste) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WhatsApp fotoğraflarını okumak -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Telefon yeniden başlayınca saatlik hatırlatmayı tekrar kurmak -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_app"
        android:roundIcon="@drawable/ic_app"
        android:label="@string/app_name"
        android:theme="@style/Tema">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Ayarlar"
            android:parentActivityName=".MainActivity" />

        <!-- Herhangi bir uygulamadan "Paylaş > WA Görevler" ile fotoğraf alma -->
        <activity
            android:name=".FotoActivity"
            android:exported="true"
            android:label="Fotoğraftan görev">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- WhatsApp "Sohbeti dışa aktar" ve düz metin paylaşımı -->
        <activity
            android:name=".IceAktarActivity"
            android:exported="true"
            android:label="WA Görevler'e aktar"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Ekran okuma: yalnızca WhatsApp açıkken görünen mesajlar -->
        <service
            android:name=".EkranOkuyucu"
            android:exported="true"
            android:label="WA Görevler ekran okuma"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ekran_okuyucu" />
        </service>

        <service
            android:name=".WaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".HatirlaticiReceiver"
            android:exported="false" />

        <!-- Görev son tarihi geldiğinde hatırlatma -->
        <receiver
            android:name=".SonTarihReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Hızlı görev ekleme penceresi (widget + ve kutucuk) -->
        <activity
            android:name=".HizliEkleActivity"
            android:exported="false"
            android:label="Yeni görev"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.Light.Dialog" />

        <!-- Ana ekran widget'ı -->
        <receiver
            android:name=".GorevWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/gorev_widget" />
        </receiver>

        <service
            android:name=".GorevWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Hızlı Ayarlar kutucuğu: panodaki metni görev yap -->
        <service
            android:name=".HizliKutucuk"
            android:exported="true"
            android:label="Görev ekle"
            android:icon="@drawable/ic_bildirim"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
